 {
  "name": "ingest_contract",
  "description": "Add a new contract PDF (absolute path on the server machine) to the index so it can be\n    queried and risk-scanned. Returns the new contract_id.",
  "inputSchema": {
   "properties": {
    "pdf_path": {
     "description": "Absolute path to a text-based PDF on the server machine",
     "title": "Pdf Path",
     "type": "string"
    },
    "title": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Display title; defaults to the file name",
     "title": "Title"
    },
    "contract_type": {
     "default": "Unknown",
     "description": "e.g. Supply, License, Distributor",
     "title": "Contract Type",
     "type": "string"
    }
   },
   "required": [
    "pdf_path"
   ],
   "title": "ingest_contractArguments",
   "type": "object"
  },
  "outputSchema": {
   "properties": {
    "contract_id": {
     "title": "Contract Id",
     "type": "string"
    },
    "title": {
     "title": "Title",
     "type": "string"
    },
    "contract_type": {
     "title": "Contract Type",
     "type": "string"
    },
    "n_pages": {
     "title": "N Pages",
     "type": "integer"
    },
    "source": {
     "title": "Source",
     "type": "string"
    }
   },
   "required": [
    "contract_id",
    "title",
    "contract_type",
    "n_pages",
    "source"
   ],
   "title": "ContractInfo",
   "type": "object"
  }
 }
]